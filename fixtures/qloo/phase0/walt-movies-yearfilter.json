    {
      "entity_id": "2A4DA1E0-E38A-43E6-BDE7-2E68C1F271BC",
      "name": "The Last Waltz",
      "type": "urn:entity",
      "properties": {
        "release_year": 1978,
        "content_rating": "PG",
        "plot_themes_description": "The film explores farewell and legacy through a nostalgic celebration of collaborative performance and the historical influence of American roots and rock artists.",
        "description": "The Last Waltz (1978), directed by Martin Scorsese, is a music documentary/biographical concert film capturing the Band's farewell performance and its cultural resonances. Featuring core members Robbie Robertson, Levon Helm, Garth Hudson, Rick Danko and Richard Manuel alongside guest artists such as Neil Young and Muddy Waters, the film intersperses live sets with candid interviews and archival context. It functions as both a document of a single landmark concert and a broader meditation on legacy, collaboration, and the roots of American rock. The overall tone is celebratory and nostalgic while maintaining a careful, cinematic presentation of the performances."
      },
