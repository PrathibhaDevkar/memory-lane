    {
      "entity_id": "FAB2E88B-F7F4-4C3D-8B9B-8164124438CF",
      "name": "Let It Be",
      "type": "urn:entity",
      "properties": {
        "release_year": 1970,
        "content_rating": "G",
        "plot_themes_description": "The film explores how fame and creative pressures shape collaboration and friendship, documenting the tensions that lead a celebrated group toward dissolution while preserving moments of musical communion.",
        "description": "Let It Be (1970), directed by Michael Lindsay-Hogg and featuring John Lennon, Paul McCartney, George Harrison and Ringo Starr, is a music documentary that chronicles the band’s attempt to return to basics in the studio. The film intercuts rehearsal and recording sessions with candid backstage interactions and culminates in an impromptu rooftop concert, highlighting both creative highs and mounting interpersonal strain. Themes include the creative process, fame, collaboration and the emotional cost of artistic life; the film’s tone is simultaneously celebratory and melancholy. The original release earned recognition for its score and is widely regarded as an essential document of the group’s final live performance."
      },
      "genres": [
