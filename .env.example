# Copy to .env.local and fill in. .env.local is gitignored: never commit keys.
# On Vercel, set the same names under Settings → Environment Variables (mark keys as Sensitive).
# A value already set in your shell wins over this file.

# API keys (server only; the browser never sees them)
QLOO_API_KEY=
ANTHROPIC_API_KEY=

# Where kits come from: "fixture" (the saved sample kit, no API calls) or "agent" (live Claude + Qloo).
# npm run dev:agent sets agent for you.
KIT_SOURCE=fixture

# Claude settings (these are the defaults)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Limits on live kits (lib/ratelimit.ts). Production refuses live kits until Redis is configured;
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN. Optional locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=
VISITOR_KITS_PER_HOUR=3
DAILY_LIVE_KITS=100

# Lets scripts/smoke.mjs skip the limits. Make one with: openssl rand -hex 24
SMOKE_TOKEN=
