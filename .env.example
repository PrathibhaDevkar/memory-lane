# Copy to .env.local and fill in. .env.local is gitignored: never commit keys.
# On Vercel, set the same names under Settings → Environment Variables (mark keys as Sensitive).
# A value already set in your shell wins over this file.

# API keys (server only; the browser never sees them)
QLOO_API_KEY=
ANTHROPIC_API_KEY=

# Where kits come from: "fixture" (the saved sample kit, no API calls) or "agent" (live Claude + Qloo).
# npm run dev:agent sets agent for you.
KIT_SOURCE=fixture

# Claude settings (these are the defaults). Team rule (CLAUDE.md): Haiku 5.5 by default. Sonnet or Opus
# only after both of you approve a smoke-check audit (npm run smoke -- --report); record it in
# CLAUDE_MODEL_APPROVAL, naming the model, or the app falls back to Haiku.
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MODEL_APPROVAL=
CLAUDE_EFFORT=low

# Token alerts (docs/token-alerts.md): returned in the X-Token-Alert header and logged as token_alert.
# Per kit:
TOKEN_ALERT_KIT_INPUT=12000
TOKEN_ALERT_KIT_OUTPUT=4000
TOKEN_ALERT_KIT_CALLS=2
TOKEN_ALERT_KIT_USD=0.05
# Per day, across all kits (needs Redis):
TOKEN_ALERT_DAILY_TOKENS=1000000
TOKEN_ALERT_DAILY_USD=1

# Limits on live kits (lib/ratelimit.ts). Production refuses live kits until Redis is configured;
# Vercel's Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN. Optional locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=
VISITOR_KITS_PER_HOUR=30
DAILY_LIVE_KITS=1000

# Hours to reuse the live kit built for the form's example profile (a fictional person), so repeat
# clicks don't call Claude. Needs Redis. No other profile is ever stored.
EXAMPLE_KIT_HOURS=6

# Lets scripts/smoke.mjs skip the limits and always build fresh. Make one with: openssl rand -hex 24
SMOKE_TOKEN=

# Product analytics (docs/analytics.md). Off unless the key is set. The project API key (phc_…) is
# public and write-only, but keep it here like the others. NEXT_PUBLIC_ values are built into the
# page, so changing them needs a rebuild. In PostHog, turn on "Cookieless server hash mode" and
# "Discard client IP data".
NEXT_PUBLIC_POSTHOG_KEY=
# us (default) or eu
NEXT_PUBLIC_POSTHOG_REGION=us
